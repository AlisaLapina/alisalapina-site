---
import { T, STATUS, photosOf, imgSrc, href } from "../lib/data.js";
const { work: w, lang } = Astro.props;
const meta = [lang === "ru" ? w.subtitle_ru || w.subtitle_en : w.subtitle_en, w.year].filter(Boolean).join(" · ");
const link = href(lang, `/works/${w.slug}`);
const photos = photosOf(w);
const thumb = w.thumb ? imgSrc(w.thumb) : photos[0]?.src || "";
---
<div class="tile">
  {thumb
    ? <a class="ph" href={link}><img src={thumb} alt={w.title} loading="lazy"></a>
    : <a class="ph empty" href={link}>{T[lang].photoSoon}</a>}
  <div class="t">
    <a class="u" href={link}>{w.title}</a>
    <span class="m">{meta}</span>
    {w.status === "Available" && <span class="av">{STATUS[lang].Available}</span>}
  </div>
</div>
