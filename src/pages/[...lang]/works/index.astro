---
import Base from "../../../layouts/Base.astro";
import Tile from "../../../components/Tile.astro";
import { langPaths, langOf, series, works, href, T } from "../../../lib/data.js";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
---
<Base lang={lang} current="works" path="/works" title={T[lang].works}>
  {series.map((s) => (
    <section class="series">
      <div class="series-head"><h2>{s.title} <span class="m">{s.year}</span></h2><a class="u m" href={href(lang, `/series/${s.id}`)}>{T[lang].aboutSeries}</a></div>
      <div class="tiles">{s.works.map((id) => <Tile work={works[id]} lang={lang} />)}</div>
    </section>
  ))}
</Base>
