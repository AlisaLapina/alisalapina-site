---
import Base from "../../layouts/Base.astro";
import { langPaths, langOf, page, works, seriesOf, href, T } from "../../lib/data.js";
export const getStaticPaths = langPaths;
const lang = langOf(Astro.params.lang);
const home = page("home");
const w = works[home.work];
const s = w && seriesOf(w.slug);
const link = w ? href(lang, `/works/${w.slug}`) : href(lang, "/works");
---
<Base lang={lang} path="/">
  <section class="home"><figure>
    <div class="pair">
      <a href={link}><img src={home.image_left} alt={w ? w.title : ""}></a>
      <a href={link}><img src={home.image_right} alt={w ? w.title : ""}></a>
    </div>
    {w && <figcaption>
      <span><a class="u" href={link}>{w.title}</a> <span class="m">{lang === "ru" ? w.subtitle_ru || w.subtitle_en : w.subtitle_en}</span></span>
      {s && <a href={href(lang, `/series/${s.id}`)} class="m">{T[lang].series}: {s.title}, {s.year}</a>}
    </figcaption>}
  </figure></section>
</Base>
